# Copy this file to `.env` and fill in your values.
# `.env` is git-ignored — your secrets never leave your machine.

# --- Tesla Fleet API credentials ---------------------------------------
# Register a developer application at https://developer.tesla.com
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
# Fleet API region: na (North America), eu (Europe), cn (China)
TESLA_REGION=na
TESLA_REDIRECT_URI=http://localhost:8080/callback
# Where OAuth tokens are stored locally (file is created with mode 600)
TESLA_TOKEN_FILE=~/.tcc/tokens.json

# --- Your vehicles -------------------------------------------------------
# Format: name=VIN, one entry per car, comma-separated.
TPP_VEHICLES=Daily=5YJ3E1EA0KF000001,Second=7SAYGDEE5PF000002

# --- Peak window ---------------------------------------------------------
# Your time-of-use plan's expensive peak hours (24h HH:MM).
# SCE default is 4–9pm; PG&E 4–9pm; APS varies by plan — check your bill.
TPP_PEAK_START=16:00
TPP_PEAK_END=21:00
# Days the peak window applies to (some plans differ on weekends).
TPP_DAYS=mon,tue,wed,thu,fri,sat,sun
# Minutes on either side of the peak start (stopping early is harmless)
# inside which a cron run acts. For the peak end, runs act at/after the
# end within grace — the resume never fires early, when power is still
# at peak price.
TPP_GRACE_MINUTES=5
# strict (default): cron runs only act within grace of the boundaries.
# window: any run inside the window stops charging if needed, any run
# outside resumes a paused car — for catching mid-peak plug-ins with an
# extra mid-window cron run.
TPP_BOUNDARY_MODE=strict

# --- Runtime ---------------------------------------------------------------
TPP_STATE_FILE=~/.tcc/peak_pause_state.json
# Dry run: log what WOULD happen without sending any commands.
TPP_DRY_RUN=false
